<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Smart Queue System</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body {
            font-family: "Inter", "Segoe UI", sans-serif;
            background-color: #f4f6f9;
            margin: 0;
        }

        .navbar-custom {
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;
        }

        .navbar-brand {
            font-weight: 600;
            color: #111827 !important;
        }

        .hero-section {
            padding: 100px 20px;
            background: #ffffff;
        }

        .hero-title {
            font-size: 42px;
            font-weight: 700;
            color: #111827;
        }

        .hero-subtitle {
            font-size: 18px;
            color: #6b7280;
            margin-top: 15px;
            margin-bottom: 40px;
        }

        .btn-main {
            padding: 14px 28px;
            font-weight: 500;
            border-radius: 8px;
        }

        .btn-primary-custom {
            background-color: #2563eb;
            border: none;
        }

        .btn-primary-custom:hover {
            background-color: #1e40af;
        }

        .btn-outline-custom {
            border: 1px solid #d1d5db;
            color: #374151;
            background: white;
        }

        .btn-outline-custom:hover {
            background: #f3f4f6;
        }

        .feature-card {
            background: #ffffff;
            border-radius: 12px;
            padding: 30px;
            border: 1px solid #e5e7eb;
            transition: 0.3s;
        }

        .feature-card:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,0.05);
        }

        footer {
            background: #111827;
            color: #9ca3af;
            padding: 25px;
            text-align: center;
            font-size: 14px;
        }
    </style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-custom px-4">
    <div class="container">
        <a class="navbar-brand" href="/">
            <i class="bi bi-grid-1x2-fill"></i> Smart Queue System
        </a>
    </div>
</nav>

<!-- HERO SECTION -->
<section class="hero-section text-center">
    <div class="container">

        <h1 class="hero-title">
            Modern Queue Management for Businesses
        </h1>

        <p class="hero-subtitle">
            Real-time token generation, counter management and administrative control — 
            built for efficiency and scalability.
        </p>

        <div class="d-flex justify-content-center gap-3 flex-wrap">

            <a href="/kiosk" class="btn btn-main btn-primary-custom">
                Generate Token
            </a>

            <a href="/dashboard" class="btn btn-main btn-outline-custom">
                Admin Dashboard
            </a>

            <a href="/counter-login" class="btn btn-main btn-outline-custom">
                Counter Login
            </a>

        </div>

    </div>
</section>

<!-- FEATURES SECTION -->
<section class="py-5">
    <div class="container">
        <div class="row g-4 text-center">

            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-speedometer2 fs-2 text-primary"></i>
                    <h5 class="mt-3">Real-Time Tracking</h5>
                    <p class="text-muted">
                        Monitor live token status and counter assignments instantly.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-shield-lock fs-2 text-primary"></i>
                    <h5 class="mt-3">Secure Counter Access</h5>
                    <p class="text-muted">
                        Role-based login system for controlled access management.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-bar-chart-line fs-2 text-primary"></i>
                    <h5 class="mt-3">Administrative Control</h5>
                    <p class="text-muted">
                        Dashboard insights and full operational visibility.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<footer>
    © 2026 Smart Queue System — Enterprise Queue Platform
</footer>

</body>
</html>