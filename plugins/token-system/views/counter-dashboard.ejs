<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= counter.counter_name %> Dashboard</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .counter-dashboard {
            max-width: 900px;
            margin: 0 auto;
            padding: 20px;
        }
        .current-token {
            background: linear-gradient(135deg, #4361ee, #3a0ca3);
            color: white;
            padding: 30px;
            border-radius: 15px;
            text-align: center;
            margin-bottom: 25px;
            box-shadow: 0 10px 25px rgba(67, 97, 238, 0.2);
            border: 3px solid white;
        }
        .token-number {
            font-size: 64px;
            font-weight: 800;
            line-height: 1;
            margin: 10px 0;
        }
        .action-buttons {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin: 25px 0;
        }
        .action-btn {
            padding: 18px;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-decoration: none;
        }
        .btn-complete {
            background: linear-gradient(135deg, #4cc9f0, #4895ef);
            color: white;
        }
        .btn-complete:hover {
            background: linear-gradient(135deg, #4895ef, #4361ee);
            transform: translateY(-3px);
        }
        .btn-call {
            background: linear-gradient(135deg, #f8961e, #f9c74f);
            color: white;
        }
        .btn-call:hover {
            background: linear-gradient(135deg, #f3722c, #f8961e);
            transform: translateY(-3px);
        }
        .btn-decline {
            background: linear-gradient(135deg, #f72585, #b5179e);
            color: white;
        }
        .btn-decline:hover {
            background: linear-gradient(135deg, #e63946, #f72585);
            transform: translateY(-3px);
        }
        .next-tokens {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
            margin-top: 20px;
            border: 1px solid #e9ecef;
        }
        .service-badge {
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            background: #e0e7ff;
            color: #4f46e5;
            border: 1px solid #c7d2fe;
        }
        .wait-time {
            font-weight: 600;
            color: #f59e0b;
        }
        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            display: inline-block;
        }
        .status-calling {
            background: #fff3cd;
            color: #856404;
        }
        .status-waiting {
            background: #d1ecf1;
            color: #0c5460;
        }
        .empty-state {
            text-align: center;
            padding: 40px;
            color: #6c757d;
        }
        .counter-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }
        .stats-box {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin: 20px 0;
        }
        .stat-item {
            background: #e7f5ff;
            padding: 15px;
            border-radius: 10px;
            text-align: center;
        }
        .stat-item:nth-child(2) {
            background: #fff3cd;
        }
    </style>
</head>
<body>
    <div class="counter-dashboard">
        <!-- Header -->
        <div class="counter-header">
            <div>
                <h1 style="margin: 0; color: #4361ee;">
                    <i class="fas fa-desktop"></i>
                    <%= counter.counter_name %>
                </h1>
                <p style="margin: 5px 0 0 0; color: #6c757d; font-size: 14px;">
                    Counter #<%= counter.counter_number %> • Staff: <%= counter.staff_name || 'Not assigned' %>
                </p>
            </div>
            <div>
                <a href="/counter-logout" class="btn" style="background: #ef4444; color: white; padding: 10px 20px;">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </div>

        <!-- Current Token Display -->
        <% if (currentToken) { %>
            <div class="current-token">
                <div style="font-size: 14px; opacity: 0.9; letter-spacing: 1px;">NOW SERVING</div>
                <div class="token-number">#<%= currentToken.token_number %></div>
                <div style="font-size: 22px; margin-top: 10px; font-weight: 500;">
                    <i class="fas fa-user"></i> <%= currentToken.customer_name %>
                </div>
                <div style="margin-top: 15px; font-size: 16px; opacity: 0.9;">
                    <span class="service-badge" style="margin-right: 15px;">
                        <i class="fas fa-cogs"></i> <%= currentToken.service_type %>
                    </span>
                    <span style="color: rgba(255,255,255,0.8);">
                        <i class="fas fa-clock"></i> Serving for: 
                        <span id="timer">00:00</span>
                    </span>
                </div>
                <% if (currentToken.cnic_num) { %>
                    <div style="margin-top: 10px; font-size: 14px; opacity: 0.8; font-family: monospace;">
                        <i class="fas fa-id-card"></i> <%= currentToken.cnic_num %>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="current-token" style="background: linear-gradient(135deg, #6b7280, #4b5563);">
                <i class="fas fa-user-clock" style="font-size: 48px; margin-bottom: 20px; opacity: 0.7;"></i>
                <div style="font-size: 24px; font-weight: 600;">No Active Token</div>
                <div style="margin-top: 10px; opacity: 0.8; font-size: 16px;">
                    Click "Call Next" to start serving a customer
                </div>
            </div>
        <% } %>

        <!-- Action Buttons -->
        <div class="action-buttons">
            <% if (currentToken) { %>
                <a href="/counter/<%= counter.id %>/complete" class="action-btn btn-complete">
                    <i class="fas fa-check-circle"></i>
                    COMPLETE
                </a>
            <% } else { %>
                <a href="/counter/<%= counter.id %>/call-next" class="action-btn btn-call">
                    <i class="fas fa-phone-alt"></i>
                    CALL NEXT
                </a>
            <% } %>
            
            <a href="/counter/<%= counter.id %>/call-next" class="action-btn btn-call">
                <i class="fas fa-forward"></i>
                SKIP / NEXT
            </a>
            
            <% if (currentToken) { %>
                <a href="/counter/<%= counter.id %>/decline" 
                   class="action-btn btn-decline"
                   onclick="return confirm('Are you sure you want to decline this token? This cannot be undone.');">
                    <i class="fas fa-times-circle"></i>
                    DECLINE
                </a>
            <% } else { %>
                <button class="action-btn" style="background: #adb5bd; color: white; cursor: not-allowed;" disabled>
                    <i class="fas fa-times-circle"></i>
                    NO TOKEN
                </button>
            <% } %>
        </div>

        <!-- Queue Statistics -->
        <div class="stats-box">
            <div class="stat-item">
                <div style="font-size: 12px; color: #0c5460; margin-bottom: 5px;">
                    <i class="fas fa-users"></i> TOTAL WAITING
                </div>
                <div style="font-size: 28px; font-weight: 700; color: #0056b3;">
                    <%= totalWaiting %>
                </div>
                <div style="font-size: 12px; color: #6c757d;">
                    customers in queue
                </div>
            </div>
            <div class="stat-item">
                <div style="font-size: 12px; color: #856404; margin-bottom: 5px;">
                    <i class="fas fa-user-clock"></i> YOUR STATUS
                </div>
                <div style="font-size: 20px; font-weight: 700; color: #e67700;">
                    <%= currentToken ? 'BUSY' : 'AVAILABLE' %>
                </div>
                <div style="font-size: 12px; color: #6c757d;">
                    <%= currentToken ? 'Serving customer' : 'Ready for next' %>
                </div>
            </div>
        </div>

        <!-- Available Tokens -->
        <div class="next-tokens">
            <h3 style="margin-bottom: 20px; color: #212529; display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-list-ol"></i> 
                Available Tokens in Queue
                <span style="font-size: 14px; background: #6c757d; color: white; padding: 3px 10px; border-radius: 20px;">
                    <%= totalWaiting %> waiting
                </span>
            </h3>
            
            <% if (waitingTokens && waitingTokens.length > 0) { %>
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; min-width: 600px;">
                        <thead>
                            <tr style="background: #f8f9fa;">
                                <th style="padding: 12px; text-align: left; color: #495057; font-weight: 600;">Token #</th>
                                <th style="padding: 12px; text-align: left; color: #495057; font-weight: 600;">Customer</th>
                                <th style="padding: 12px; text-align: left; color: #495057; font-weight: 600;">Service</th>
                                <th style="padding: 12px; text-align: left; color: #495057; font-weight: 600;">Wait Time</th>
                                <th style="padding: 12px; text-align: left; color: #495057; font-weight: 600;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% waitingTokens.forEach(token => { %>
                            <tr style="border-bottom: 1px solid #e9ecef; transition: background 0.2s;">
                                <td style="padding: 15px; font-weight: 700; color: #4361ee;">
                                    #<%= token.token_number %>
                                </td>
                                <td style="padding: 15px;">
                                    <div style="font-weight: 500;"><%= token.customer_name %></div>
                                    <% if (token.cnic_num) { %>
                                        <div style="font-size: 12px; color: #6c757d; font-family: monospace;">
                                            <%= token.cnic_num %>
                                        </div>
                                    <% } %>
                                </td>
                                <td style="padding: 15px;">
                                    <span class="service-badge">
                                        <% if (token.service_type === 'New') { %>
                                            <i class="fas fa-plus-circle"></i>
                                        <% } else if (token.service_type === 'Update') { %>
                                            <i class="fas fa-edit"></i>
                                        <% } else { %>
                                            <i class="fas fa-redo"></i>
                                        <% } %>
                                        <%= token.service_type %>
                                    </span>
                                </td>
                                <td style="padding: 15px;">
                                    <span class="wait-time">
                                        <i class="fas fa-clock"></i>
                                        <%= token.wait_time || 0 %> min
                                    </span>
                                </td>
                                <td style="padding: 15px;">
                                    <span class="status-badge status-waiting">
                                        <i class="fas fa-clock"></i> WAITING
                                    </span>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                
                <div style="margin-top: 20px; padding: 15px; background: #e7f5ff; border-radius: 8px; text-align: center;">
                    <i class="fas fa-info-circle" style="color: #0056b3; margin-right: 8px;"></i>
                    <span style="color: #0056b3; font-size: 14px;">
                        Click "Call Next" to assign the next available token (#<%= waitingTokens[0] ? waitingTokens[0].token_number : '?' %>) to your counter
                    </span>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-inbox" style="font-size: 48px; color: #adb5bd; margin-bottom: 15px;"></i>
                    <h4 style="color: #6c757d; margin-bottom: 10px;">Queue is Empty</h4>
                    <p style="color: #6c757d; max-width: 400px; margin: 0 auto 20px;">
                        No tokens are currently waiting in the queue. 
                        Tokens will appear here when customers generate them from the kiosk.
                    </p>
                    <a href="/kiosk" class="btn" style="background: #4361ee; color: white; padding: 10px 20px;">
                        <i class="fas fa-external-link-alt"></i> Go to Kiosk
                    </a>
                </div>
            <% } %>
        </div>

        <!-- System Status Footer -->
        <div style="margin-top: 25px; text-align: center; color: #6c757d; font-size: 13px; padding-top: 15px; border-top: 1px solid #e9ecef;">
            <div style="display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; margin-bottom: 10px;">
                <span>
                    <i class="fas fa-sync-alt"></i> Auto-refresh in <span id="refreshCount">30</span>s
                </span>
                <span>
                    <i class="fas fa-database"></i> Last updated: <span id="currentTime"><%= new Date().toLocaleTimeString() %></span>
                </span>
                <% if (isPaused) { %>
                    <span style="color: #ef4444; font-weight: 600;">
                        <i class="fas fa-pause-circle"></i> SYSTEM PAUSED
                    </span>
                <% } else { %>
                    <span style="color: #38b000; font-weight: 600;">
                        <i class="fas fa-play-circle"></i> SYSTEM ACTIVE
                    </span>
                <% } %>
            </div>
            <div style="font-size: 12px; color: #adb5bd;">
                Smart Queue System v2.1 • Counter Interface
            </div>
        </div>
    </div>

    <!-- Main JavaScript - NO EJS IN JS CODE -->
    <script>
        // Timer for current token
        let startTime = Date.now();
        function updateTimer() {
            const elapsed = Date.now() - startTime;
            const minutes = Math.floor(elapsed / 60000);
            const seconds = Math.floor((elapsed % 60000) / 1000);
            const timerElement = document.getElementById('timer');
            if (timerElement) {
                timerElement.textContent = 
                    `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            }
        }
        
        // Start timer if timer element exists
        if (document.getElementById('timer')) {
            setInterval(updateTimer, 1000);
        }
        
        // Auto-refresh countdown
        let refreshTime = 30;
        const countdownElement = document.getElementById('refreshCount');
        if (countdownElement) {
            const countdown = setInterval(() => {
                refreshTime--;
                countdownElement.textContent = refreshTime;
                if (refreshTime <= 0) {
                    clearInterval(countdown);
                    location.reload();
                }
            }, 1000);
        }
        
        // Update current time
        function updateCurrentTime() {
            const now = new Date();
            const timeString = now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            const timeElement = document.getElementById('currentTime');
            if (timeElement) {
                timeElement.textContent = timeString;
            }
        }
        setInterval(updateCurrentTime, 60000);
        
        // Check if has token by looking at the DOM
        function hasActiveToken() {
            // Check if "No Active Token" message is visible
            const noTokenMessage = document.querySelector('.current-token');
            if (noTokenMessage && noTokenMessage.textContent.includes('No Active Token')) {
                return false;
            }
            // Check if token number is displayed
            const tokenNumber = document.querySelector('.token-number');
            return tokenNumber && tokenNumber.textContent.trim() !== '' && !tokenNumber.textContent.includes('--');
        }
        
        // Auto-refresh only if no token
        if (!hasActiveToken()) {
            setInterval(() => {
                fetch(window.location.href)
                    .then(response => response.text())
                    .then(html => {
                        if (html.includes('NOW SERVING')) {
                            location.reload();
                        }
                    })
                    .catch(err => console.log('Auto-refresh check skipped'));
            }, 10000);
        }
        
        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // Ctrl + N = Call Next
            if (e.ctrlKey && e.key === 'n') {
                e.preventDefault();
                const callNextBtn = document.querySelector('a[href*="/call-next"]');
                if (callNextBtn) callNextBtn.click();
            }
            
            // Ctrl + C = Complete
            if (e.ctrlKey && e.key === 'c') {
                e.preventDefault();
                const completeBtn = document.querySelector('a[href*="/complete"]');
                if (completeBtn) completeBtn.click();
            }
            
            // F5 = Manual refresh
            if (e.key === 'F5') {
                e.preventDefault();
                location.reload();
            }
        });
        
        // Initialize
        updateCurrentTime();
        
        // Auto-refresh safety (2 minutes)
        setTimeout(() => {
            location.reload();
        }, 120000);
        
        // Initial check
        updateTimer();
    </script>
</body>
</html>