<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Token Generated | Smart Queue</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
:root {
    --primary: #0f172a;
    --accent: #2563eb;
    --success: #16a34a;
    --muted: #64748b;
    --border: #e5e7eb;
    --bg: #f8fafc;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
}

html, body {
    height: 100%;
}

body {
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden; /* remove scroll */
}

/* Card */
.card {
    width: 100%;
    max-width: 520px;
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid var(--border);
    padding: 32px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.05);
}

/* Header */
.header {
    text-align: center;
    margin-bottom: 20px;
}

.status-icon {
    width: 52px;
    height: 52px;
    background: rgba(22,163,74,0.1);
    color: var(--success);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px;
    font-size: 20px;
}

.header h1 {
    font-size: 20px;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 4px;
}

.header p {
    font-size: 13px;
    color: var(--muted);
}

/* Service */
.service-label {
    display: inline-block;
    padding: 4px 10px;
    font-size: 11px;
    border-radius: 4px;
    background: #eef2ff;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 16px;
}

/* Token */
.token-section {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 20px;
    text-align: center;
    margin-bottom: 18px;
}

.token-label {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 1px;
}

.token-number {
    font-size: 48px;
    font-weight: 700;
    color: var(--primary);
    margin: 6px 0;
}

.customer-name {
    font-size: 13px;
    color: var(--muted);
}

/* Info */
.info {
    background: #f1f5f9;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px;
    font-size: 12px;
    margin-bottom: 16px;
}

/* Queue */
.queue {
    border-top: 1px solid var(--border);
    padding-top: 12px;
    margin-top: 12px;
}

.queue-item {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    margin-bottom: 8px;
}

.queue-item span:last-child {
    font-weight: 600;
}

.position {
    color: var(--accent);
}

/* Buttons */
.actions {
    display: flex;
    gap: 10px;
    margin-top: 18px;
}

.btn {
    flex: 1;
    padding: 8px;
    border-radius: 6px;
    font-size: 13px;
    cursor: pointer;
    border: 1px solid var(--border);
    background: white;
    transition: 0.2s;
}

.btn:hover {
    background: #f3f4f6;
}

.btn-primary {
    background: var(--accent);
    color: white;
    border: none;
}

.btn-primary:hover {
    background: #1d4ed8;
}

/* Footer */
.footer {
    margin-top: 14px;
    text-align: center;
    font-size: 11px;
    color: var(--muted);
}

.redirect {
    position: absolute;
    bottom: 12px;
    width: 100%;
    text-align: center;
    font-size: 11px;
    color: var(--muted);
}

/* Print */
@media print {
    body { overflow: visible; }
    .actions, .redirect { display: none; }
    .card {
        box-shadow: none;
        border: none;
    }
}
</style>
</head>

<body>

<div class="card">

    <div class="header">
        <div class="status-icon">
            <i class="fas fa-check"></i>
        </div>
        <h1>Token Issued</h1>
        <p>Please wait for your number</p>
    </div>

    <% if (serviceType === 'New') { %>
        <div class="service-label">New CNIC Application</div>
    <% } else if (serviceType === 'Update') { %>
        <div class="service-label">CNIC Update</div>
    <% } else { %>
        <div class="service-label">CNIC Renewal</div>
    <% } %>

    <div class="token-section">
        <div class="token-label">TOKEN</div>
        <div class="token-number"><%= tokenNumber %></div>
        <div class="customer-name"><%= customerName %></div>
    </div>

    <% if (requiredCNIC) { %>
        <div class="info">
            CNIC verification required at counter.
        </div>
    <% } else { %>
        <div class="info">
            No CNIC required.
        </div>
    <% } %>

    <div class="queue">
        <div class="queue-item">
            <span>Queue Position</span>
            <span class="position">#3</span>
        </div>
        <div class="queue-item">
            <span>Est. Wait</span>
            <span>15–20 mins</span>
        </div>
    </div>

    <div class="actions">
        <button onclick="window.print()" class="btn">Print</button>
        <a href="/kiosk" class="btn btn-primary" style="text-align:center;text-decoration:none;">
            New Token
        </a>
    </div>

    <div class="footer">
        Generated at: <%= currentTime || new Date().toLocaleTimeString() %>
    </div>

</div>

<div class="redirect">
    Redirecting in <span id="countdown">10</span> seconds...
</div>

<script>
let seconds = 10;
const countdownEl = document.getElementById('countdown');

const interval = setInterval(() => {
    seconds--;
    if (countdownEl) countdownEl.textContent = seconds;
    if (seconds <= 0) {
        clearInterval(interval);
        window.location.href = '/kiosk';
    }
}, 1000);
</script>

</body>
</html>